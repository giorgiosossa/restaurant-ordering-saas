# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# OPENPAY CONFIGURATION (EDGE FUNCTIONS)
# ============================================
# Get these from your Openpay dashboard
# IMPORTANT: Keep PRIVATE_KEY secret - only use in Edge Functions

# Merchant ID
OPENPAY_MERCHANT_ID=your_merchant_id_here

# Private Key (Backend only - NEVER expose to frontend)
OPENPAY_PRIVATE_KEY=your_private_key_here

# Environment: 'sandbox' or 'production'
OPENPAY_ENVIRONMENT=sandbox

# Webhook URL (Update this with your actual domain in production)
OPENPAY_WEBHOOK_URL=https://your-domain.com/webhooks/openpay

# ============================================
# OPENPAY CONFIGURATION (FRONTEND - VITE)
# ============================================
# These are safe to expose in the frontend (VITE_ prefix)
VITE_OPENPAY_MERCHANT_ID=your_merchant_id_here
VITE_OPENPAY_PUBLIC_KEY=your_public_key_here
VITE_OPENPAY_ENVIRONMENT=sandbox
